# Public Supabase settings used by the browser and server.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only credential for privileged administrative operations.
# Never prefix this variable with VITE_ or expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Server-only honeypot settings. Use a random secret with at least 32 characters.
HONEYPOT_HASH_SECRET=replace-with-a-random-32-character-or-longer-secret
# Comma-separated IP addresses that must never be blocked (for example, staff VPN egress IPs).
HONEYPOT_TRUSTED_IPS=

# Choose worker_only when serving only through workers.dev. This checks restriction records
# in the Worker and does not require Cloudflare zone credentials.
HONEYPOT_ENFORCEMENT_MODE=worker_only

# Optional Cloudflare zone-scoped IP Access Rules integration for custom domains.
# Required only when HONEYPOT_ENFORCEMENT_MODE=cloudflare_zone.
CLOUDFLARE_ZONE_ID=your-cloudflare-zone-id
CLOUDFLARE_ZONE_HOSTNAME=example.com
CLOUDFLARE_API_TOKEN=your-zone-read-and-firewall-edit-token
